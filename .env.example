# Copie para .env e ajuste. O .env real nao vai para o repositorio.

# Banco (bate com o docker-compose.yml)
DATABASE_URL="postgresql://elite:elite@localhost:5432/elite_events?schema=public"

# Autenticacao — gere um valor proprio: openssl rand -hex 32
JWT_SECRET="troque-este-valor"
JWT_EXPIRES_IN="7d"

# Catalogo externo — https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# URLs
API_PORT=3333
WEB_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3333"

# Minutos que uma reserva PENDING segura o assento antes de expirar
RESERVATION_HOLD_MINUTES=10
