# Ambiente dos testes e2e. Versionado de proposito: nao ha segredo aqui.
#
# Usa o MESMO container de Postgres do desenvolvimento, em um schema separado.
# Assim os testes destroem e recriam dados a vontade sem tocar no banco em que
# voce esta clicando. Ver specs/001-decisoes-em-aberto/quickstart.md.

DATABASE_URL="postgresql://elite:elite@localhost:5432/elite_events?schema=test"

JWT_SECRET="segredo-de-teste-nao-usar-fora-daqui"
JWT_EXPIRES_IN="1h"

# O catalogo nao e chamado nos testes; o valor existe so para o ConfigService
# nao falhar na inicializacao do modulo.
TMDB_API_KEY="test"
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

API_PORT=3334
WEB_BASE_URL="http://localhost:3000"

RESERVATION_HOLD_MINUTES=10
